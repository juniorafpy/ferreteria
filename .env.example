# --- Base de datos local ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ferre

# --- Supabase ---
# Runtime de la app (Transaction pooler, puerto 6543):
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
# Migraciones y seed (conexión directa o Session pooler, puerto 5432):
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
#
# Opcionales (normalmente se detectan solos):
# DATABASE_SSL=true
# DATABASE_PREPARE=false
# DATABASE_POOL_MAX=10

# --- Sesión ---
# Secreto HMAC para la cookie de sesión (mínimo 32 caracteres aleatorios).
SESSION_SECRET=cambie-este-secreto-en-produccion
